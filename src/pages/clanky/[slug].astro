---
import Jumbotron from '@components/Jumbotron.astro'
import Layout from '@layouts/Layout.astro'
import type { MarkdownInstance } from 'astro'

type PostFrontmatter = {
  title: string
  image?: string
  publishDate: string
}

type Post = MarkdownInstance<PostFrontmatter>

type StaticPath = {
  params: { slug: string | undefined }
  props: { post: Post }
}

export async function getStaticPaths() {
  const posts = Object.values(
    import.meta.glob<Post>('../../data/posts/*/*.md', { eager: true }),
  )

  return posts.map((post): StaticPath => ({
    params: { slug: post.file.split('/')?.pop()?.split('.').shift() },
    props: { post },
  }))
}

const { Content, frontmatter } = Astro.props.post;
const { title, image, publishDate } = frontmatter;

---

<Layout>
  <Jumbotron title={title} subtitle={publishDate} image={image || 'nad_rybniky.jpg'} />
  <div class="container">
    <article class="content">
      <Content />
    </article>
  </div>
</Layout>

<style is:global>
article {
  font-size: 1.4rem;
  p {max-width: 100%;}
  img {
    display: block;
    width: 100%;
    max-width: 800px;
    margin: 1rem auto;
  }
}

.gallery { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin: 24px 0; }
.gallery img { width: 120px; height: 120px; object-fit: cover; margin: 0; }
</style>